# marketplace 环境变量模板（复制为 .env 后填入真实值）
# ⚠️ 禁止把真实值提交到 git/公开仓库；.env 不入库

# --- 数据库 / 缓存（内部 docker 网络地址） ---
MONGODB_URI=mongodb://admin:CHANGE_ME@mongodb:27017/?authSource=admin
MONGODB_DB=yuezhitong
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# --- 安全 secrets（务必轮换后使用） ---
# 曾在公开仓库泄露，请生成新值：
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME
INTERNAL_TOKEN=CHANGE_ME

# --- AI keys（2026-09-02 起代码从环境变量读取，不再硬编码） ---
# 曾在公开仓库泄露，已吊销后请填入新 key
DASHSCOPE_API_KEY=
GEMINI_API_KEY=

# --- 服务 ---
PORT=8010
